# website：多阶段构建
# builder 含编译工具链；runtime 仅保留运行所需库，显著减小镜像体积
FROM python:3.12-slim AS builder

ARG USE_CN_MIRROR=1
ARG APT_MIRROR=mirrors.aliyun.com
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

COPY docker/scripts/debian-apt-cn.sh /tmp/debian-apt-cn.sh
# uwsgi 需从源码编译：仅在此阶段安装 gcc / libpcre2-dev
# 项目使用 PyMySQL，无需 default-libmysqlclient-dev
RUN if [ "${USE_CN_MIRROR}" = "1" ]; then chmod +x /tmp/debian-apt-cn.sh && APT_MIRROR="${APT_MIRROR}" /tmp/debian-apt-cn.sh; fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpcre2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY website/requirements.txt ./requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

# ---------- runtime ----------
FROM python:3.12-slim

LABEL org.opencontainers.image.title="xxgcms/website"
LABEL org.opencontainers.image.description="xxg-cms Django public website (uWSGI)"

ARG USE_CN_MIRROR=1
ARG APT_MIRROR=mirrors.aliyun.com

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY docker/scripts/debian-apt-cn.sh /tmp/debian-apt-cn.sh
# 运行时仅需 PCRE 动态库（uwsgi 链接用）；不含 gcc 等编译工具
RUN if [ "${USE_CN_MIRROR}" = "1" ]; then chmod +x /tmp/debian-apt-cn.sh && APT_MIRROR="${APT_MIRROR}" /tmp/debian-apt-cn.sh; fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    libpcre2-8-0 \
    && rm -rf /var/lib/apt/lists/* /tmp/debian-apt-cn.sh

COPY --from=builder /usr/local /usr/local

WORKDIR /app

# 仅 website Python 应用
COPY website/ ./
COPY docker/scripts/wait-for-mysql.sh \
     docker/scripts/sync-env-from-config.sh \
     docker/scripts/entrypoint-website.sh \
     /docker/scripts/
COPY docker/uwsgi/website.ini /docker/uwsgi/website.ini

RUN chmod +x /docker/scripts/*.sh \
    && mkdir -p /var/log/xxgcms

ENV DJANGO_SETTINGS_MODULE=apps.settings.prod

EXPOSE 8003

CMD ["/docker/scripts/entrypoint-website.sh"]
